rules_version = '2';

// Who can read and write FlatDesk's data.
// Each building lives at buildings/{code}. You can open a building only if you
// know its code: nobody can list all buildings. Hackathon demo, so there are no
// accounts yet; anyone with the code can use that building's board.
service cloud.firestore {
  match /databases/{database}/documents {
    match /buildings/{code} {
      allow get: if true;
      allow list: if false;
      // Only brand new buildings, with a sensible size.
      allow create: if request.resource.data.code == code
                    && request.resource.data.residents is list
                    && request.resource.data.residents.size() <= 5000;
      // After that, only the residents list can change (admin adding or removing people).
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['residents'])
                    && request.resource.data.residents is list
                    && request.resource.data.residents.size() <= 5000;
      allow delete: if false;

      match /complaints/{id} {
        allow read, create, update: if true;
        allow delete: if false;
      }
      match /announcements/{id} {
        allow read, create, delete: if true;
        allow update: if false;
      }
    }
  }
}
